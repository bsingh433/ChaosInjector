# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# --- Build output ---
# Anchored so the Maven output dir is ignored but NOT the `target` Java package.
/target/
/backend/target/
/frontend/dist/

# --- Node / frontend ---
node_modules/
npm-debug.log*
.vite/

# --- IDE ---
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# Keep the Maven wrapper jar even though *.jar is ignored above
!.mvn/wrapper/maven-wrapper.jar
