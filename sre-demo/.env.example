# Copy to `.env` and fill in. NEVER commit real secrets.
# Only the SELECTED LLM provider's credentials need to be set (Phase B+).

# --- Grafana (demo) ---
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin

# --- SRE Agent: LLM provider selection (Phase B) ---
# provider: azure-responses | openai-responses | anthropic-messages
LLM_PROVIDER=azure-responses
LLM_MODEL=gpt-5
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=4000

# --- SRE Agent: remediation gating (Phase C) ---
# propose (default; never executes) | prompt (ask on console) | auto (execute)
REMEDIATION_MODE=propose

# --- Azure OpenAI (Responses API) — default provider ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_API_KEY=
# Optional: use Azure AD instead of a key (leave AZURE_OPENAI_API_KEY blank)
# AZURE_USE_AAD=false

# --- OpenAI direct (Responses API) ---
OPENAI_API_KEY=

# --- Anthropic / Claude (Messages API) ---
ANTHROPIC_API_KEY=
ANTHROPIC_VERSION=2023-06-01
