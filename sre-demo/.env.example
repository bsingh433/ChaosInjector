# Copy to `.env` and fill in. NEVER commit real secrets.
# Only the SELECTED LLM provider's credentials need to be set (Phase B+).

# --- Grafana (demo) ---
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin

# --- SRE Agent: LLM provider selection (Phase B) ---
# provider: azure-responses | openai-responses | anthropic-messages | openai-chat
LLM_PROVIDER=azure-responses
LLM_MODEL=gpt-5
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2000

# --- SRE Agent: remediation gating (Phase C) ---
# propose (default; never executes) | prompt (ask on console) | auto (execute)
REMEDIATION_MODE=propose

# --- Azure OpenAI (Responses API) — default provider ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_API_KEY=
# Optional: use Azure AD instead of a key (leave AZURE_OPENAI_API_KEY blank)
# AZURE_USE_AAD=false

# --- OpenAI direct (Responses API) ---
OPENAI_API_KEY=

# --- OpenAI-compatible Chat Completions (provider: openai-chat) ---
# Works with any OpenAI-compatible endpoint. For Groq:
#   LLM_PROVIDER=openai-chat
#   LLM_MODEL=llama-3.3-70b-versatile      # a Groq model that supports tool use
#   OPENAI_CHAT_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_CHAT_API_KEY=gsk_...            # your Groq API key
# Falls back to OPENAI_API_KEY / api.openai.com if these are unset.
# Groq free tier is rate-limited (~12k tokens/min). The agent auto-retries 429s
# (honouring Retry-After), but if RCA still trips the limit, lower the analysis
# window / LLM_MAX_OUTPUT_TOKENS, or upgrade your Groq tier.
OPENAI_CHAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_CHAT_API_KEY=

# --- Anthropic / Claude (Messages API) ---
ANTHROPIC_API_KEY=
ANTHROPIC_VERSION=2023-06-01
